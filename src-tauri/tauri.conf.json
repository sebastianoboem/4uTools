{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoBackup",
  "version": "0.3.2",
  "identifier": "com.autobackup.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoBackup",
        "width": 960,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' http://localhost:1420 ws://localhost:1420 https://github.com https://objects.githubusercontent.com https://release-assets.githubusercontent.com; img-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost https://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$DOCUMENT/**",
            "$PICTURE/**",
            "$DOWNLOAD/**",
            "$DESKTOP/**",
            "/Users/**",
            "/Volumes/**",
            "C:/**",
            "D:/**",
            "E:/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3MEMwNjUyNENCQ0E4NTEKUldSUnFMeE1VZ1lNdDBhRlBGQnJmSUNXQTZXRmVMTXdZV2x1NUVRMUVqc2lQYW5YYzlJVFF1WUMK",
      "endpoints": [
        "https://github.com/sebastianoboem/AutoBackup/releases/latest/download/latest.json"
      ]
    }
  }
}
