{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "4uTools",
  "mainBinaryName": "4uTools",
  "version": "2.8.7",
  "identifier": "com.4utools.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "4uTools",
        "width": 1200,
        "height": 880,
        "minWidth": 1200,
        "minHeight": 880
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$HOME/**",
            "$DOCUMENT/**",
            "$PICTURE/**",
            "$DOWNLOAD/**",
            "$DESKTOP/**",
            "/Users/**",
            "/Volumes/**",
            "C:/**",
            "D:/**",
            "E:/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "resources": [
      "../resources/battery-catalog.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2M0U5Q0JFMjA5NjNDMTgKUldRWVBKWWd2cHcrTnNSdU9zSFczZE9RR3VXeEJBYi9wbWRzWjQ4SjBpeFVNd1RPMktaRXhWdHkK",
      "endpoints": [
        "https://github.com/sebastianoboem/4uTools/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
