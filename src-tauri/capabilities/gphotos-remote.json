{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "gphotos-remote",
  "description": "Google Photos may report selection engine events only.",
  "windows": ["main"],
  "webviews": ["gphotos"],
  "remote": {
    "urls": [
      "https://photos.google.com/*",
      "https://accounts.google.com/*",
      "https://*.google.com/*"
    ]
  },
  "permissions": ["allow-gphotos-engine-event"]
}
