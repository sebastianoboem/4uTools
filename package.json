{
  "name": "4utools",
  "private": true,
  "version": "2.8.6",
  "type": "module",
  "scripts": {
    "dev": "npm run build:gphotos-engine && vite",
    "build": "npm run build:gphotos-engine && tsc && vite build",
    "build:gphotos-engine": "vite build --config vite.gphotos-engine.config.ts",
    "test": "vitest run",
    "tauri": "tauri",
    "setup:adb": "bash scripts/download-platform-tools.sh",
    "release:manifest": "node scripts/generate-latest-json.mjs",
    "release:build": "bash scripts/release-build.sh",
    "battery:catalog": "cargo run -p fourutools --bin build-battery-catalog"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
