{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PriceCreator",
  "version": "1.0.1",
  "identifier": "com.doctorphone.pricecreator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cartellini Prezzo — Doctor Phone",
        "width": 1180,
        "height": 800,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4RkRGRjVGNEZENjZEMzMKUldRemJkWlBYLy85MkVJbUdhYjRMVjQ1d1VMbnB0dVNxelJQL2laTEZGQlhYajA4UjFCcHNvQWMK",
      "endpoints": [
        "https://github.com/sebastianoboem/PriceCreator/releases/latest/download/latest.json"
      ]
    }
  }
}
